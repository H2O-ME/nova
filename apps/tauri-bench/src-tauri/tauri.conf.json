{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Desktop",
  "version": "0.1.0",
  "identifier": "com.nova.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../../packages/web/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nova Desktop",
        "width": 1280,
        "height": 840,
        "center": true,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "../runtime": "runtime/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
