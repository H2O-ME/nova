{
  "name": "nova-agent",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint packages",
    "dev": "pnpm --filter @nova-agent/cli dev",
    "nova": "node packages/cli/dist/index.mjs",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "release": "changeset version && node scripts/sync-root-version.mjs && git add -A && git commit -m \"chore(release): bump versions via changesets\" && changeset tag",
    "release:status": "changeset status"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.4.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
