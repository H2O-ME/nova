// NovaAgent — 包间依赖与外部集成图（L2/L3，current-state, M11）
// 证据: scripts/dep-direction.mjs ALLOW 白名单 + 各包 package.json dependencies
//       + packages/*/src 内 `@nova-agent/*` import 实测计数（2026-09-20, 三方吻合）
// 渲染: npx -y @hpcc-js/wasm-graphviz-cli -T svg system-dependencies.dot > system-dependencies.svg
//       （dot-wasm 取位置参数、只写 stdout，不支持 -o；本机无原生 graphviz）
//       拓扑以本 .dot 为准，SVG 是它的渲染
digraph novaagent {
    rankdir=TB;
    splines=true;
    nodesep=0.4; ranksep=0.7;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f5f5f5"];
    edge [fontname="Helvetica", fontsize=9];

    // ── 内核层：零上游（dep-direction.mjs 强制；实测 core/tui 源码 0 处 @nova-agent import）
    subgraph cluster_kernel {
        label="内核层（零上游，pnpm gates 机检）"; style=dashed; color="#888888";
        core   [label="core\nagent 循环 · 会话 JSONL v2\nkernel/（AgentSession 句柄 · KernelEvent 协议）\ntool 调度 · token 估算 · request-trim\ncompact 全家 · context 片段 · presentation 词汇表", fillcolor="#cfe3f7"];
        tui    [label="tui\n差分渲染(?2026) · 按键解码\nCJK 宽度 · 能力探测", fillcolor="#cfe3f7"];
    }

    // ── 能力层：只依赖内核
    subgraph cluster_mid {
        label="能力层"; style=dashed; color="#888888";
        ai      [label="ai\nOpenAI 兼容客户端\nSSE · 重试 · usage 提取\n(→core 仅类型)", fillcolor="#d8ecc8"];
        plugins [label="plugins\n插件宿主 · 审批\nbuiltin 工具 · skills\nPTC run_code(worker 线程)\ncreateAgentKernel 装配单源", fillcolor="#d8ecc8"];
    }

    // ── Surface 层：内核事件流的消费者（官方与第三方同地位）
    subgraph cluster_surface {
        label="Surface 层（KernelEvent 消费者，与第三方同地位）"; style=dashed; color="#888888";
        tuiApp [label="tui-app\nTUI surface（nova 默认）\n纯函数层 blocks→entries→render\n→panels→frame\n壳层 app/keys（无版面算术）", fillcolor="#e6d8f0"];
        web    [label="web\nWebUI surface（nova --web）\nHTTP 静态托管 + 单 WS 事件流\n自写 RFC6455 · HMAC cookie\nui/ 前端（React 18+Vite）", fillcolor="#e6d8f0"];
        qqbot  [label="qqbot\nQQ 网关 WS 状态机\ntoken · REST · qqbot_send", fillcolor="#e6d8f0"];
    }

    cli   [label="cli（产品壳 bin=nova）\nargv → surface 装配 · config 发现 · 模型元数据\ncommand-runner（斜杠命令语义单源，两壳共用）\nexec 非交互 · repl 回落", fillcolor="#f7d0d0"];

    // 内部依赖（边标签 = src 内 import 实测次数）
    ai      -> core   [label="types-only ×1"];
    plugins -> core   [label="×26"];
    tuiApp  -> tui    [label="×6"];
    tuiApp  -> core   [label="×8"];
    web     -> core   [label="×4"];
    web     -> plugins [label="×2"];
    qqbot   -> core   [label="×2"];
    qqbot   -> plugins [label="×2"];
    cli     -> core   [label="×11"];
    cli     -> tui    [label="×4"];
    cli     -> tuiApp [label="×1"];
    cli     -> web    [label="×2"];
    cli     -> ai     [label="×3"];
    cli     -> plugins [label="×8"];
    cli     -> qqbot  [label="×1"];

    // ── 外部系统（跨信任边界，虚线）
    node [shape=box3d, fillcolor="#e0e0e0"];
    provider [label="OpenAI 兼容 LLM 端点\n{baseURL}/chat/completions"];
    modelsdev [label="models.dev\n/api.json"];
    qqopen  [label="QQ 开放平台\napi.bot.qq.com / api.sgroup.qq.com"];
    browser [label="浏览器（本机）\nlaunch token → HttpOnly cookie"];
    novaDir [shape=folder, label="~/.nova/\nconfig · sessions · cache · skills\n(工作区零写入)"];
    user    [shape=ellipse, fillcolor="#ffffff", label="用户"];

    edge [style=dashed];
    user    -> cli      [label="nova（TUI）/ --web / exec / qqbot", style=solid];
    user    -> browser  [label="localhost URL", style=solid];
    browser -> web      [label="HTTP + WebSocket（本机）"];
    ai      -> provider [label="fetch+SSE · prompt_cache_key"];
    cli     -> modelsdev [label="24h 缓存回落"];
    qqbot   -> qqopen   [label="WS + REST"];
    core    -> novaDir  [label="JSONL 先写盘\n溢出/存档"];
    cli     -> novaDir  [label="config.json 唯一源"];
}