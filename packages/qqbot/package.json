{
  "name": "@nova-agent/qqbot",
  "version": "0.2.2",
  "type": "module",
  "description": "QQ 机器人接入插件（腾讯机器人开放平台 WebSocket 通道）：入站消息 → agent 回复 → REST 被动回复。作为第三方插件编写示范，只依赖 core/plugins 公共 API。",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nova-agent/core": "workspace:*",
    "@nova-agent/plugins": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}