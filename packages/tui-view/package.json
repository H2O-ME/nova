{
  "name": "@nova-agent/tui-view",
  "version": "0.1.0",
  "type": "module",
  "description": "Pure view layer for the nova TUI: tokens, labels, clipping, tool lines, status, popups, composer, reasoning, spacing, splash, frame assembly. Zero terminal IO.",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nova-agent/core": "workspace:*",
    "@nova-agent/plugins": "workspace:*",
    "@nova-agent/tui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
