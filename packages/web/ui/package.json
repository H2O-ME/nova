{
  "name": "nova-web-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "DesktopUI：Next.js 16（App Router，静态导出）+ Tailwind v4 + shadcn 风格 chat 原语。产物同步到 packages/web/public，由桌面壳加载（帧走 stdio 桥，不经过 HTTP）。样式两层：src/components/ui 为 chat 原语，其余组件用 CSS Modules + design/tokens；两层共用 --nova-* token。规格见 DESIGN.md。",
  "scripts": {
    "dev": "next dev --webpack --port 5101",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "postbuild": "node scripts/sync-export.mjs"
  },
  "dependencies": {
    "@nova-agent/core": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "next": "^16.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.9.0"
  }
}
