{
  "name": "nova-web-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "WebUI 前端（M11 批2）：React 18 + Vite，构建产物落在 packages/web/public，由同进程 node http 托管。样式是 CSS Modules + token 层（design/tokens），不引 UI 框架。",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nova-agent/core": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
