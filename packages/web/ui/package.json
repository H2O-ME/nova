{
  "name": "nova-web-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "WebUI 前端：Next.js 16（App Router，静态导出）+ Tailwind v4 + shadcn/ui（Radix）。产物落在 packages/web/public，由同进程 node http 托管（/ws 与鉴权不经过 Next）。样式三层：src/components/ui 为 shadcn 原语，src/ui 为 Aceternity 组件，存量组件 sheet 用 CSS Modules + design/tokens；三层共用 --nova-* token。",
  "scripts": {
    "dev": "next dev --webpack --port 5101",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "postbuild": "node scripts/sync-export.mjs"
  },
  "dependencies": {
    "@nova-agent/core": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "motion": "^14.4.0",
    "next": "^16.4.2",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.9.0"
  }
}
