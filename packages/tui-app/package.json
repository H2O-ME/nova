{
  "name": "@nova-agent/tui-app",
  "version": "0.4.0",
  "type": "module",
  "description": "新 TUI surface（M11 批4）：按 grok pager 逐值移植的 scrollback 状态机 + 单时钟 + GrokNight 配色，消费内核事件流与呈现词汇表。只依赖 tui/core/plugins 公共 API。",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./surface": {
      "types": "./dist/surface.d.mts",
      "default": "./dist/surface.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nova-agent/core": "workspace:*",
    "@nova-agent/plugins": "workspace:*",
    "@nova-agent/tui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
